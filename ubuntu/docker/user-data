#cloud-config

locale: "en_US.UTF-8"
timezone: "Asia/Phnom_Penh"

ssh_pwauth: false

groups:
  - cloud-users
  - docker

users:
  - default

system_info:
  default_user:
    groups: [docker]

package_update: true
# package_upgrade: true
# package_reboot_if_required: true
packages:
  apt:
    - apt-transport-https
    - ca-certificates
    - containerd.io
    - curl
    - docker-buildx-plugin
    - docker-ce
    - docker-ce-cli
    - docker-compose-plugin
    - gh
    - git
    - gnupg
    - gnupg-agent
    - lsb-release
    - qemu-guest-agent
    - software-properties-common

apt:
  primary:
    - arches: [default]
      uri: http://us.archive.ubuntu.com/ubuntu/
